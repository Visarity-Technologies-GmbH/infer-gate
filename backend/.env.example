HOST=127.0.0.1
PORT=3000
# true uses MySQL; false uses the local built-in SQLite database.
DB_ENABLED=false
# Used only when DB_ENABLED=false. Defaults to backend/data/infergate.sqlite.
SQLITE_DB_PATH=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iguser
DB_PASSWORD=PASSWORD
DB_NAME=IGDB
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=/qh9oCk8hq8jSpXVaYsFw16y1a8AnI7F3tKca//6obk
# Generate a separate random value; required to claim the initial administrator.
BOOTSTRAP_TOKEN=Xi+g//RJdOcM2a0qm8dU46oxC4VwrUw+ACSAxgiIX40
MODEL_DEFAULT=DENY
UPSTREAM_TIMEOUT_MS=900000
# Role scripts: per-fetch deadline and total execution deadline (milliseconds)
SCRIPT_FETCH_TIMEOUT_MS=60000
SCRIPT_TOTAL_TIMEOUT_MS=300000
BODY_LIMIT_BYTES=10485760

# Redis caches
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TIMEOUT_MS=100
CLASSIFICATION_CACHE_TTL_SECONDS=3600
STRING_CACHE_TTL_SECONDS=3600
STRING_CACHE_MAX_LENGTH=32768

# Upstream model catalogue cache (seconds)
MODEL_CATALOGUE_CACHE_TTL_SECONDS=300
