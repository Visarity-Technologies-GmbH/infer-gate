{
  "name": "infergate-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --test",
    "test:integration": "node --env-file-if-exists=.env scripts/integration-runner.js"
  },
  "dependencies": {
    "@redis/client": "^6.3.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.0"
  }
}
